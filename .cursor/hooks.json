{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/pr-gate.sh",
        "matcher": "gh\\s+pr\\s+create",
        "timeout": 120,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/mcp-pr-gate.sh",
        "timeout": 15,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/mcp-pr-gate.sh",
        "matcher": "^MCP:",
        "timeout": 15,
        "failClosed": true
      }
    ]
  }
}
